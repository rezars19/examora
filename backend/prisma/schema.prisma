generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPERADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ONGOING
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  FORCE_SUBMITTED
  BLOCKED
}

model School {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique @db.VarChar(30)
  name         String       @db.VarChar(150)
  operatorName String       @map("operator_name") @db.VarChar(150)
  email        String       @db.VarChar(150)
  phone        String?      @db.VarChar(30)
  status       SchoolStatus @default(PENDING)
  settings     Json?        @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users         User[]
  classes       Class[]
  subjects      Subject[]
  questionBanks QuestionBank[]
  exams         Exam[]

  @@map("schools")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @map("school_id") @db.Uuid
  subjectId    String?  @map("subject_id") @db.Uuid
  role         UserRole
  identifier   String   @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school              School?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject             Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studentClasses      StudentClass[]
  questionBanksCreated QuestionBank[]
  examAttempts        ExamAttempt[]

  @@unique([schoolId, identifier])
  @@map("users")
}

model Class {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  name         String   @db.VarChar(50)
  academicYear String   @map("academic_year") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at")

  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students    StudentClass[]
  examClasses ExamClass[]

  @@map("classes")
}

model StudentClass {
  studentId String   @map("student_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([studentId, classId])
  @@map("student_classes")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  code      String   @db.VarChar(30)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers      User[]
  questionBanks QuestionBank[]
  exams         Exam[]

  @@map("subjects")
}

model QuestionBank {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  title       String   @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  questions Question[]

  @@map("question_banks")
}

model Question {
  id          String       @id @default(uuid()) @db.Uuid
  bankId      String       @map("bank_id") @db.Uuid
  type        QuestionType
  content     String       @db.Text
  mediaUrl    String?      @map("media_url") @db.Text
  points      Float        @default(1.0)
  options     Json?        // List of [{ id: "A", text: "...", isCorrect: true }]
  explanation String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  bank    QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@map("questions")
}

model Exam {
  id                 String     @id @default(uuid()) @db.Uuid
  schoolId           String     @map("school_id") @db.Uuid
  subjectId          String     @map("subject_id") @db.Uuid
  title              String     @db.VarChar(150)
  description        String?    @db.Text
  token              String     @db.VarChar(10)
  proctorPin         String     @map("proctor_pin") @db.VarChar(10)
  durationMinutes    Int        @map("duration_minutes")
  startTime          DateTime   @map("start_time")
  endTime            DateTime   @map("end_time")
  randomizeQuestions Boolean    @default(true) @map("randomize_questions")
  randomizeOptions   Boolean    @default(true) @map("randomize_options")
  maxViolations      Int        @default(3) @map("max_violations")
  status             ExamStatus @default(DRAFT)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examClasses ExamClass[]
  attempts    ExamAttempt[]

  @@map("exams")
}

model ExamClass {
  examId  String @map("exam_id") @db.Uuid
  classId String @map("class_id") @db.Uuid

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([examId, classId])
  @@map("exam_classes")
}

model ExamAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  examId         String        @map("exam_id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  startTime      DateTime      @default(now()) @map("start_time")
  endTime        DateTime      @map("end_time")
  submitTime     DateTime?     @map("submit_time")
  status         AttemptStatus @default(IN_PROGRESS)
  score          Float?
  violationCount Int           @default(0) @map("violation_count")
  questionOrder  Json          @map("question_order") // Shuffled items snapshot
  deviceInfo     Json?         @map("device_info")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]
  logs    ExamLog[]

  @@unique([examId, studentId])
  @@map("exam_attempts")
}

model ExamAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  attemptId         String   @map("attempt_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  selectedOptionIds String[] @default([]) @map("selected_option_ids")
  essayText         String?  @map("essay_text") @db.Text
  isDoubtful        Boolean  @default(false) @map("is_doubtful")
  updatedAt         DateTime @updatedAt @map("updated_at")

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("exam_answers")
}

model ExamLog {
  id        BigInt   @id @default(autoincrement())
  attemptId String   @map("attempt_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(50)
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("exam_logs")
}
